{
  // Typechecks the tests alongside the source. The build config compiles `src`
  // into `dist`; this one emits nothing and simply widens the net.
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": true,
    // nothing is emitted here, so the src-only rootDir does not apply
    "rootDir": ".",
    "types": ["node", "vitest/globals"],
    // Test fixtures index into seeded arrays constantly and assert on the
    // result; making every one of those a possibly-undefined check buys
    // nothing here. `src` is still built under the strict config.
    "noUncheckedIndexedAccess": false,
    "exactOptionalPropertyTypes": false
  },
  "include": ["src", "test", "vitest.config.ts"]
}
